<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.simplified.simplified-annotations</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Simplified Annotations</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/simplified-dev">Simplified Dev</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <p>
      Three annotation families for Java with companion IDE tooling:
      <b>@ResourcePath</b> (static resource-path validation), <b>@XContract</b>
      (superset of JetBrains <code>@Contract</code>), and <b>@ClassBuilder</b>
      (Lombok-<code>@Builder</code> superset with annotation-processor code generation).
    </p>

    <h3>@ClassBuilder</h3>
    <ul>
      <li>Annotation processor generates a sibling <code>&lt;TypeName&gt;Builder.java</code>
          for every class, record, or interface annotated with <code>@ClassBuilder</code>.
          Interfaces also get a matching <code>&lt;Name&gt;Impl</code> concrete class.</li>
      <li>Full Lombok <code>@Builder</code> parity: configurable method names
          (<code>builderMethodName</code>, <code>buildMethodName</code>,
          <code>fromMethodName</code>, <code>toBuilderMethodName</code>),
          method prefix, access level, custom factory method, exclusions.</li>
      <li>Setter-shape extras that Lombok doesn't cover: dual
          <code>Optional&lt;T&gt;</code> setters, zero-arg + typed boolean pairs
          with <code>@Negate</code>, <code>@PrintFormat</code> string overloads
          via <code>@Formattable</code>, <code>@Collector</code> varargs / iterable bulk
          overloads with opt-in single-element add/put, clear, and lazy put-if-absent
          for collections and maps, defensive-copy <code>from(T)</code>, and a
          <code>mutate()</code> instance shorthand.</li>
      <li><b>Per-field rules</b> as standalone annotations:
          <code>retainInit</code> - on by default, and overridable per field with
          <code>@BuilderDefault</code> - copies the field's declared initializer
          into the builder so unset fields start at the intended value
          (<code>UUID.randomUUID()</code>, sensible strings, pre-populated
          collections) instead of the JVM default; <code>@BuilderIgnore</code>
          excludes a single field; <code>@ObtainVia</code> redirects
          <code>from(T)</code> to a non-standard accessor - an instance method,
          a static helper, or a different field - when the target type doesn't
          expose a matching getter.</li>
      <li><b>@BuildFlag validation</b> enforces
          <code>nonNull</code> / <code>notEmpty</code> / <code>group</code>
          mutual-requirement / regex <code>pattern</code> / length
          <code>limit</code> in the generated <code>build()</code>. The checks
          are emitted into the builder, so a constraint costs nothing on the
          runtime classpath.</li>
      <li><b>@XContract</b> annotations are emitted on every generated method
          so IntelliJ data-flow analysis understands fresh-object and
          this-return shapes.</li>
      <li>IDE inspections: <b>Bootstrap-methods missing</b> (ERROR-level) with
          a quick-fix that inserts <code>builder()</code> / <code>from(T)</code>
          / <code>mutate()</code> all at once; <b>@ClassBuilder field
          annotations</b> catches mistakes like <code>@Formattable</code> on a
          non-String field.</li>
    </ul>

    <h3>@ResourcePath</h3>
    <ul>
      <li><b>Resource Path</b> inspection - verifies that every annotated field, parameter, or
          method return resolves to a file that exists in the project's content source roots
          (or in user-configured additional roots). Supports an optional <code>base</code>
          attribute that prefixes the validated path.</li>
      <li><b>Resource Path Base-Prefix Usage</b> inspection - catches the common runtime mistake
          of passing a <code>@ResourcePath(base="X")</code> parameter raw into a resource-loading
          call (<code>Class.getResourceAsStream</code>, <code>new File(...)</code>, etc.)
          without prepending <code>X/</code>. Offers a quick-fix. Also flags base mismatches
          across method boundaries.</li>
      <li>Value resolution follows literals, concatenation, final/static/enum fields, local
          variables, method-call return values (recursively), and enum-constructor bindings,
          with bounded recursion and result size.</li>
      <li>Settings: custom resource-root paths, glob-based file exclusions, separate severity
          for invalid-base errors.</li>
    </ul>

    <h3>@XContract</h3>
    <ul>
      <li>Superset of JetBrains <code>@Contract</code> with a richer grammar: relational
          comparisons, <code>&amp;&amp;</code> / <code>||</code> with grouping, named-parameter
          references, <code>instanceof</code> conditions, typed <code>throws</code> returns,
          chained comparisons (<code>0 &lt;= index &lt; size()</code>), and full
          <code>pure</code> / <code>mutates</code> support.</li>
      <li>A built-in <code>InferredAnnotationProvider</code> synthesises an equivalent
          <code>@Contract</code> for every <code>@XContract</code> method, so IntelliJ's
          data-flow analysis works from a single annotation.</li>
      <li><b>XContract</b> inspection validates contract syntax, parameter references, type
          references, <code>mutates</code> tokens, and flags overrides that weaken a super
          method's contract.</li>
      <li><b>XContract Violation at Call Site</b> inspection warns when a call's literal
          arguments deterministically trigger a <code>fail</code> or <code>throws</code>
          clause.</li>
    </ul>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.lang</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Simplified Annotations" displayType="BALLOON"/>
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.resourcepath.ResourcePathInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="ResourcePathInspection"
                displayName="Resource Path"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.resourcepath.ResourcePathUsageInspection"
                enabledByDefault="true"
                level="WARNING"
                shortName="ResourcePathUsageInspection"
                displayName="Resource Path Base-Prefix Usage"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.xcontract.XContractInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="XContractInspection"
                displayName="XContract"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.xcontract.XContractCallInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="XContractCallInspection"
                displayName="XContract Violation at Call Site"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.classbuilder.inspect.ClassBuilderFieldInspection"
                enabledByDefault="true"
                level="WARNING"
                shortName="ClassBuilderFieldInspection"
                displayName="@ClassBuilder field annotations"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.lazy.inspect.LazyFieldInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="LazyFieldInspection"
                displayName="@Lazy field"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.enumlookup.inspect.EnumLookupInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="EnumLookupInspection"
                displayName="@EnumLookup"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.enumlookup.inspect.EnumLookupKeyInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="EnumLookupKeyInspection"
                displayName="@KeyField duplicate / null key"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.args.inspect.ArgsConstructorInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="ArgsConstructorInspection"
                displayName="Constructor annotations"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.accessor.inspect.AccessorInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="AccessorInspection"
                displayName="@Getter / @Setter"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.utility.inspect.UtilityClassInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="UtilityClassInspection"
                displayName="@UtilityClass"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.classbuilder.inspect.GetterVisibilityInspection"
                enabledByDefault="true"
                level="WARNING"
                shortName="GetterVisibilityInspection"
                displayName="@Getter accessor width and hand-written accessors"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.silentthrows.inspect.SilentThrowsInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="SilentThrowsInspection"
                displayName="@SilentThrows"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.cleanup.inspect.CleanupInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="CleanupInspection"
                displayName="@Cleanup"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.equality.inspect.EqualsAndHashCodeInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="EqualsAndHashCodeInspection"
                displayName="@EqualsAndHashCode"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.equality.inspect.ToStringInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="ToStringInspection"
                displayName="@ToString"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.log.inspect.LogInspection"
                enabledByDefault="true"
                level="ERROR"
                shortName="LogInspection"
                displayName="@Log"
                groupPath="Simplified Annotations"
                groupName="Misuse"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.equality.inspect.EqualityConsistencyInspection"
                enabledByDefault="true"
                level="WARNING"
                shortName="EqualityConsistencyInspection"
                displayName="Hand-written equals and hashCode read different state"
                groupName="Simplified Annotations"
        />
        <localInspection
                language="JAVA"
                implementationClass="dev.simplified.equality.inspect.ReplaceableEqualityInspection"
                enabledByDefault="true"
                level="WEAK WARNING"
                shortName="ReplaceableEqualityInspection"
                displayName="Hand-written equals and hashCode @EqualsAndHashCode would generate"
                groupName="Simplified Annotations"
        />
        <custom.exception.handler implementation="dev.simplified.silentthrows.editor.SilentThrowsExceptionHandler"/>
        <lang.inspectionSuppressor language="JAVA" implementationClass="dev.simplified.cleanup.inspect.CleanupSuppressor"/>
        <lang.inspectionSuppressor language="JAVA" implementationClass="dev.simplified.shared.inspect.GeneratedMemberSuppressor"/>
        <daemon.highlightInfoFilter implementation="dev.simplified.shared.inspect.GeneratedMemberHighlightFilter"/>
        <lang.inferredAnnotationProvider implementation="dev.simplified.xcontract.XContractInferredAnnotationProvider"/>
        <lang.inferredAnnotationProvider implementation="dev.simplified.classbuilder.editor.ClassBuilderInferredAnnotationProvider"/>
        <lang.inferredAnnotationProvider implementation="dev.simplified.args.editor.ArgsInferredAnnotationProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.classbuilder.editor.ClassBuilderAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.lazy.editor.LazyAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.enumlookup.editor.EnumLookupAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.accessor.editor.AccessorAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.args.editor.ArgsAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.utility.editor.UtilityClassAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.equality.editor.WholeObjectAugmentProvider"/>
        <lang.psiAugmentProvider implementation="dev.simplified.log.editor.LogAugmentProvider"/>
        <java.elementFinder implementation="dev.simplified.classbuilder.editor.ClassBuilderElementFinder" order="last"/>
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="dev.simplified.classbuilder.editor.ClassBuilderLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="dev.simplified.equality.editor.WholeObjectLineMarkerProvider"/>
        <iconProvider implementation="dev.simplified.classbuilder.editor.ClassBuilderIconProvider"/>
        <intentionAction>
            <language>JAVA</language>
            <className>dev.simplified.classbuilder.editor.OptionalSetterNullIntention</className>
            <category>Simplified Annotations</category>
        </intentionAction>
        <postStartupActivity implementation="dev.simplified.resourcepath.ResourcePathStartupActivity"/>
        <postStartupActivity implementation="dev.simplified.classbuilder.editor.ClassBuilderStartupActivity"/>
    </extensions>
</idea-plugin>